# django-api/.env.production
# Copie para django-api/.env.production e preencha os valores reais.
# NUNCA commitar este arquivo (já está no .gitignore/.dockerignore).

SECRET_KEY=troque-por-uma-chave-aleatoria-de-50-chars-minimo
DEBUG=False
ALLOWED_HOSTS=api.mediclaw.com.br

# Postgres — mesmo nome/senha usados no .env da raiz (docker-compose.prod.yml)
DB_NAME=mediclaw
DB_USER=postgres
DB_PASSWORD=troque-por-uma-senha-forte
# DB_HOST e DB_PORT são fixados pelo docker-compose.prod.yml (host "postgres")

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=1

CORS_ALLOWED_ORIGINS=https://mediclaw.com.br,https://www.mediclaw.com.br
CSRF_TRUSTED_ORIGINS=https://mediclaw.com.br,https://www.mediclaw.com.br,https://api.mediclaw.com.br

# Nginx já termina o TLS; mantenha True em produção.
SECURE_SSL_REDIRECT=True

# AI Engine — defina apenas o provedor que for usar
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini

# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=AIza...
# CHAT_MODEL=gemini-1.5-flash

HISTORY_WINDOW=6
MAX_TOKENS_PER_RESPONSE=800
DATA_CAPTURE_LLM=true

# RAG (ChromaDB persistido em volume Docker — ver docker-compose.prod.yml)
CHROMA_PERSIST_DIR=/app/chroma_data
ANONYMIZED_TELEMETRY=False
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_MIN_SCORE=0.40
