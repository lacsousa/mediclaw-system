# .env  (raiz do repo — copie este arquivo para ".env", nesse mesmo lugar)
#
# O Docker Compose lê automaticamente um arquivo chamado ".env" na mesma
# pasta do docker-compose.prod.yml para interpolar variáveis dentro do
# próprio compose (senha do Postgres, URL da API no build do painel etc.).
# Por isso o nome final TEM que ser ".env", não ".env.production".
#
# NUNCA commitar o arquivo real (".env" já está no .gitignore).

# Postgres — precisa bater com django-api/.env.production
DB_NAME=mediclaw
DB_USER=postgres
DB_PASSWORD=troque-por-uma-senha-forte

# URL pública da API, embutida no build do Next.js (client-side)
NEXT_PUBLIC_API_URL=https://api.mediclaw.com.br

# E-mail usado pelo Let's Encrypt para avisos de expiração (nginx/init-letsencrypt.sh)
LETSENCRYPT_EMAIL=voce@exemplo.com
